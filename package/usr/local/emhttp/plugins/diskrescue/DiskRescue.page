$docroot = '/usr/local/emhttp';
require_once __DIR__ . '/include/helpers.php';

// CSRF token：webGUI 会把它作为全局变量 $csrf_token 提供；兼容不同版本。
$csrf = dr_csrf_token();
$cfg = dr_config();
$st  = dr_status();
$disks = dr_disks();

$running = !empty($st['alive']);
$phaseNames = [
    0 => '待机',
    1 => '检查',
    2 => '建目录',
    3 => '枚举文件',
    4 => '复制中',
    5 => '预扫描',
    6 => '已完成',
];
$curPhase = isset($st['phase_num']) ? (int)$st['phase_num'] : 0;
?>
<link type="text/css" rel="stylesheet" href="/plugins/diskrescue/css/diskrescue.css?v=<?=@filemtime(__DIR__ . '/css/diskrescue.css')?>">
<input type="hidden" id="dr-csrf" value="<?=dr_h($csrf)?>">
<input type="hidden" id="dr-api" value="/plugins/diskrescue/include/api.php">

<div class="dr-wrap" id="dr-app"
     data-running="<?=$running ? 1 : 0?>"
     data-state="<?=dr_h(isset($st['state']) ? $st['state'] : 'idle')?>">

  <div class="dr-head">
    <div class="dr-title">
      <span class="dr-logo">⛑</span>
      <div>
        <h2>坏盘数据抢救</h2>
        <div class="dr-sub">把坏盘上的文件尽量完整地复制到健康磁盘。复制过程中会监控速度，连续低于阈值时自动跳过卡死的文件，并保留已抢救出的部分数据。</div>
      </div>
    </div>
    <div class="dr-head-actions">
      <button type="button" class="dr-btn dr-btn-ghost" id="dr-reload" title="重新加载本页面">刷新</button>
      <button type="button" class="dr-btn dr-btn-ghost" id="dr-clear" <?=$running ? 'disabled' : ''?>>清空状态</button>
    </div>
  </div>

  <noscript><div class="dr-alert dr-alert-warn">本页面需要启用 JavaScript 才能工作。</div></noscript>

  <div class="dr-alert dr-alert-warn" id="dr-running-tip" style="<?=$running ? '' : 'display:none'?>">
    当前有一个抢救任务在运行（PID <span id="dr-pid"><?=dr_h(isset($st['pid']) ? $st['pid'] : '')?></span>）。
    刷新页面不会中断任务，点击“停止”可以安全结束。
  </div>

  <!-- ============================ 表单 ============================ -->
  <form id="dr-form" class="dr-card" autocomplete="off" onsubmit="return false;">

